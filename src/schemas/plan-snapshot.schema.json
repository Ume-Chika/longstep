{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Longstep Plan Snapshot",
  "description": "Longstepが1計画の現在状態を保持するためのJSON形式",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "goal",
    "nodes",
    "meta"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "$ref": "#/$defs/goal"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "meta": {
      "$ref": "#/$defs/meta"
    }
  },
  "$defs": {
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "deadline",
        "successCriteria"
      ],
      "properties": {
        "statement": {
          "type": "string"
        },
        "deadline": {
          "anyOf": [
            { "const": "" },
            { "type": "string", "format": "date" }
          ]
        },
        "successCriteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "targetDate",
        "description",
        "nextAction",
        "dependsOn"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "not_started",
            "completed"
          ]
        },
        "targetDate": {
          "anyOf": [
            { "const": "" },
            { "type": "string", "format": "date" }
          ]
        },
        "description": {
          "type": "string"
        },
        "nextAction": {
          "type": "string"
        },
        "goalLevel": {
          "enum": [
            "major",
            "middle",
            "minor",
            "loop"
          ]
        },
        "recurrence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "cadence",
            "completedCount"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "cadence": {
              "type": "string"
            },
            "completedCount": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
